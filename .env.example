# Copy to .env, fill in, then: chmod 600 .env
# NEVER commit .env.

# Hyperliquid API (agent) wallet private key — trade-only, generated from the
# master account at https://app.hyperliquid.xyz/API. The master key never
# touches the server.
HL_API_WALLET_KEY=0x...

# The master account address the agent trades on behalf of.
HL_ACCOUNT_ADDRESS=0x...

# true = Hyperliquid testnet, false = mainnet.
HL_TESTNET=true

# true = read-only: log + Telegram the orders it WOULD place, never trade.
DRY_RUN=false

# Long random shared secret carried inside the TradingView alert payload.
# Generate: openssl rand -hex 32
WEBHOOK_TOKEN=

# Long random segment of the webhook URL path: https://<domain>/webhook/<this>
# Generate: openssl rand -hex 16
WEBHOOK_PATH_SECRET=

# Telegram bot (create via @BotFather) and YOUR numeric chat id (@userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# healthchecks.io ping URL (external dead-man switch). Leave empty to disable.
HEALTHCHECKS_URL=

# Domain Caddy serves (used by docker-compose / Caddyfile).
DOMAIN=bot.example.com

# Email for Let's Encrypt registration.
ACME_EMAIL=you@example.com
